<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Your Password</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap');
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:#0F172A;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#CBD5E1;-webkit-font-smoothing:antialiased}
    .wrapper{max-width:600px;margin:0 auto;padding:32px 16px}
    .header{text-align:center;padding:28px 40px 22px;background:linear-gradient(135deg,#1E293B 0%,#0F172A 100%);border-radius:16px 16px 0 0;position:relative;overflow:hidden}
    /* header border handled inline */
    .card{background:#1E293B;border:1px solid #334155;border-top:none;padding:40px}
    .footer{background:#0F172A;border:1px solid #1E293B;border-top:none;border-radius:0 0 16px 16px;padding:20px 40px;text-align:center}
    .footer p{font-size:11px;color:#334155;line-height:1.8}
    .footer a{color:#475569;text-decoration:none}
    .icon-circle{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:28px;background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.3)}
    .section-label{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;font-weight:600;color:#8B5CF6;text-align:center;margin-bottom:10px}
    .headline{font-family:'Outfit',sans-serif;font-size:26px;font-weight:700;color:#F1F5F9;line-height:1.3;margin-bottom:8px;text-align:center}
    .sub{font-size:14px;color:#64748B;text-align:center;line-height:1.65;margin-bottom:32px}
    .btn-wrap{text-align:center;margin:28px 0 16px}
    .btn{display:inline-block;padding:14px 44px;background:linear-gradient(135deg,#7C3AED,#6366F1);color:#fff!important;font-family:'Inter',sans-serif;font-size:15px;font-weight:600;text-decoration:none;border-radius:10px}
    .expiry{text-align:center;font-size:12px;color:#475569;margin-top:12px}
    .expiry strong{color:#8B5CF6}
    .divider{border:none;border-top:1px solid #1E293B;margin:28px 0}
    .alert-box{background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);border-radius:10px;padding:14px 18px;font-size:13px;color:#94A3B8;line-height:1.6}
    @media(max-width:600px){.card,.header,.footer{padding:24px 20px}.headline{font-size:22px}}
  </style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto 8px auto;">
      <tr>
        <td align="center" valign="middle" style="padding-right:10px;">
          <!--[if !mso]><!-->
          <!-- Mirror mark: circle + clock hands using CSS -->
          <div style="width:40px;height:40px;border-radius:50%;border:4px solid #a78bfa;background:#1a0d2e;position:relative;display:inline-block;">
            <!-- Hour hand ~10 o'clock: rotated div -->
            <div style="position:absolute;width:3px;height:11px;background:#c084fc;border-radius:2px;bottom:50%;left:50%;transform-origin:bottom center;transform:translateX(-50%) rotate(-50deg);margin-left:-1px;"></div>
            <!-- Minute hand ~2 o'clock -->
            <div style="position:absolute;width:2px;height:13px;background:#a78bfa;border-radius:2px;bottom:50%;left:50%;transform-origin:bottom center;transform:translateX(-50%) rotate(60deg);margin-left:-1px;"></div>
            <!-- Center pivot dot -->
            <div style="position:absolute;width:5px;height:5px;background:#c084fc;border-radius:50%;top:50%;left:50%;transform:translate(-50%,-50%);"></div>
          </div>
          <!--<![endif]-->
        </td>
        <td align="left" valign="middle">
          <span style="font-family:Outfit,Arial,sans-serif;font-size:26px;font-weight:900;letter-spacing:-0.5px;line-height:1;mso-line-height-rule:exactly;">
            <span style="color:#c084fc;">Qu</span><span style="color:#f0f4ff;">by</span>
          </span>
        </td>
      </tr>
    </table>
  </div>
  <div class="card">
    <div class="icon-circle">🔑</div>
    <div class="section-label">Password Reset</div>
    <h1 class="headline">Reset your<br/>password</h1>
    <p class="sub">We received a request to reset your Quby password.<br/>Click the button below to choose a new one.</p>

    <div class="btn-wrap">
      <a href="{{resetUrl}}" class="btn">Reset My Password</a>
    </div>
    <p class="expiry">This link expires in <strong>1 hour</strong> &nbsp;·&nbsp; Do not share this link</p>

    <hr class="divider"/>

    <div class="alert-box">
      If you did not request a password reset, please ignore this email — your account remains secure. We will never ask for your password over email or phone.
    </div>
  </div>
  <div class="footer">
    <p>© 2026 Quby. All rights reserved.<br/>
    <a href="#">Unsubscribe</a> · <a href="#">Privacy Policy</a> · <a href="#">Help</a></p>
  </div>
</div>
</body>
</html>
