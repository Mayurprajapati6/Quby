<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Leave Request</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap');
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:#0f0f0f;font-family:'DM Sans',sans-serif;color:#e8e0d5;-webkit-font-smoothing:antialiased}
    .wrapper{max-width:600px;margin:0 auto;padding:40px 20px}
    .header{text-align:center;padding:40px 40px 32px;background:linear-gradient(160deg,#1a1410 0%,#0f0f0f 100%);border-top:3px solid #c9a96e;border-radius:12px 12px 0 0}
    .logo-mark{display:inline-block;width:48px;height:48px;background:#c9a96e;border-radius:10px;line-height:48px;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#0f0f0f;margin-bottom:16px}
    .brand-name{font-family:'Playfair Display',serif;font-size:22px;font-weight:600;color:#c9a96e;letter-spacing:2px;text-transform:uppercase}
    .brand-tagline{font-size:12px;color:#6b6057;letter-spacing:1px;margin-top:4px}
    .card{background:#161410;border:1px solid #2a2420;border-top:none;padding:40px}
    .footer{background:#0c0c0c;border:1px solid #2a2420;border-top:none;border-radius:0 0 12px 12px;padding:24px 40px;text-align:center}
    .footer p{font-size:11px;color:#3d3530;line-height:1.8}
    .footer a{color:#6b5d4e;text-decoration:none}
    .icon-circle{width:64px;height:64px;border-radius:50%;background:#2e2010;border:1px solid #4d3820;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:28px}
    .section-label{font-size:10px;color:#c9a96e;letter-spacing:2px;text-transform:uppercase;margin-bottom:12px}
    .headline{font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:#f0e8dc;line-height:1.25;margin-bottom:8px;text-align:center}
    .sub{font-size:13px;color:#6b6057;text-align:center;margin-bottom:28px;letter-spacing:0.5px}
    .info-block{background:#1e1a16;border:1px solid #2a2420;border-left:3px solid #c9a96e;border-radius:0 8px 8px 0;padding:20px 24px;margin:24px 0}
    .info-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #2a2420}
    .info-row:last-child{border-bottom:none}
    .info-label{font-size:11px;color:#5a5048;letter-spacing:1px;text-transform:uppercase}
    .info-value{font-size:14px;color:#d4c4b0;font-weight:500;text-align:right}
    .reason-block{background:#1e1a16;border:1px solid #2a2420;border-radius:8px;padding:16px 20px;margin:20px 0}
    .reason-title{font-size:11px;color:#5a5048;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px}
    .reason-text{font-size:14px;color:#a09080;line-height:1.6}
    .btn-wrap{text-align:center;margin:32px 0;display:flex;gap:12px;justify-content:center}
    .btn{display:inline-block;padding:13px 28px;background:#5ecb6b;color:#0f0f0f!important;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;border-radius:4px}
    .btn-outline{display:inline-block;padding:12px 28px;background:transparent;color:#e05555!important;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;border:1px solid #e05555;border-radius:4px}
    .body-text{font-size:15px;color:#a09080;line-height:1.75;margin-bottom:16px}
    @media(max-width:600px){.card,.header,.footer{padding:28px 24px}.headline{font-size:22px}.info-row{flex-direction:column;align-items:flex-start;gap:4px}.info-value{text-align:left}.btn-wrap{flex-direction:column}}
  </style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <div class="logo-mark">Q</div>
    <div class="brand-name">{{appName}}</div>
    <div class="brand-tagline">Owner Notification</div>
  </div>
  <div class="card">
    <div class="icon-circle">📅</div>
    <div class="section-label" style="text-align:center">Leave Request</div>
    <h1 class="headline">{{staffName}}<br/>requests leave.</h1>
    <p class="sub">Hi {{ownerName}}, your stylist has submitted a leave request.</p>

    <div class="section-label">Request Details</div>
    <div class="info-block">
      <div class="info-row">
        <span class="info-label">Staff</span>
        <span class="info-value">{{staffName}}</span>
      </div>
      <div class="info-row">
        <span class="info-label">Leave Type</span>
        <span class="info-value">{{leaveType}}</span>
      </div>
      <div class="info-row">
        <span class="info-label">From</span>
        <span class="info-value">{{formatDate startDate}}</span>
      </div>
      <div class="info-row">
        <span class="info-label">To</span>
        <span class="info-value">{{formatDate endDate}}</span>
      </div>
    </div>

    <div class="section-label">Reason</div>
    <div class="reason-block">
      <div class="reason-text">{{reason}}</div>
    </div>

    <p class="body-text">Please review this request and respond via the dashboard. Your stylist will be notified once you approve or reject.</p>

    <div class="btn-wrap">
      <a href="{{approveUrl}}" class="btn">Approve</a>
      <a href="{{rejectUrl}}" class="btn-outline">Reject</a>
    </div>
  </div>
  <div class="footer">
    <p>© 2026 {{appName}}. All rights reserved.<br/>
    <a href="#">Unsubscribe</a> · <a href="#">Privacy Policy</a> · <a href="#">Help</a></p>
  </div>
</div>
</body>
</html>
