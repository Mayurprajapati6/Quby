<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <title>{{subject}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #0f0f0f;
      font-family: 'DM Sans', sans-serif;
      color: #e8e0d5;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper {
      max-width: 600px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    /* ── Header ── */
    .header {
      text-align: center;
      padding: 40px 40px 32px;
      background: linear-gradient(160deg, #1a1410 0%, #0f0f0f 100%);
      border-top: 3px solid #c9a96e;
      border-radius: 12px 12px 0 0;
    }

    .logo-img {
      display: block;
      margin: 0 auto 16px;
      max-height: 56px;
      width: auto;
    }

    .brand-name {
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      font-weight: 600;
      color: #c9a96e;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .brand-tagline {
      font-size: 12px;
      color: #6b6057;
      letter-spacing: 1px;
      margin-top: 4px;
    }

    /* ── Body card ── */
    .card {
      background: #161410;
      border: 1px solid #2a2420;
      border-top: none;
      padding: 40px;
    }

    /* ── Footer ── */
    .footer {
      background: #0c0c0c;
      border: 1px solid #2a2420;
      border-top: none;
      border-radius: 0 0 12px 12px;
      padding: 24px 40px;
      text-align: center;
    }

    .footer p {
      font-size: 11px;
      color: #3d3530;
      line-height: 1.8;
    }

    .footer a {
      color: #6b5d4e;
      text-decoration: none;
    }

    /* ── Typography ── */
    .greeting {
      font-size: 13px;
      color: #7a7068;
      margin-bottom: 8px;
      letter-spacing: 0.5px;
    }

    .headline {
      font-family: 'Playfair Display', serif;
      font-size: 28px;
      font-weight: 700;
      color: #f0e8dc;
      line-height: 1.25;
      margin-bottom: 20px;
    }

    .body-text {
      font-size: 15px;
      color: #a09080;
      line-height: 1.75;
      margin-bottom: 16px;
    }

    /* ── Divider ── */
    .divider {
      border: none;
      border-top: 1px solid #2a2420;
      margin: 28px 0;
    }

    /* ── Info block ── */
    .info-block {
      background: #1e1a16;
      border: 1px solid #2a2420;
      border-left: 3px solid #c9a96e;
      border-radius: 0 8px 8px 0;
      padding: 20px 24px;
      margin: 24px 0;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid #2a2420;
    }

    .info-row:last-child { border-bottom: none; }

    .info-label {
      font-size: 11px;
      color: #5a5048;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .info-value {
      font-size: 14px;
      color: #d4c4b0;
      font-weight: 500;
      text-align: right;
    }

    /* ── CTA button ── */
    .btn-wrap { text-align: center; margin: 32px 0; }

    .btn {
      display: inline-block;
      padding: 14px 40px;
      background: #c9a96e;
      color: #0f0f0f !important;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 4px;
    }

    .btn-outline {
      display: inline-block;
      padding: 13px 40px;
      background: transparent;
      color: #c9a96e !important;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      text-decoration: none;
      border: 1px solid #c9a96e;
      border-radius: 4px;
    }

    /* ── Status badge ── */
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.5px;
    }

    .badge-success { background: #1a2e1a; color: #5ecb6b; border: 1px solid #2d4d2d; }
    .badge-warning { background: #2e2010; color: #c9a96e; border: 1px solid #4d3820; }
    .badge-danger  { background: #2e1010; color: #e05555; border: 1px solid #4d2020; }

    /* ── Amount highlight ── */
    .amount {
      font-family: 'Playfair Display', serif;
      font-size: 32px;
      font-weight: 700;
      color: #c9a96e;
      text-align: center;
      padding: 20px 0;
    }

    .amount-label {
      font-size: 11px;
      color: #5a5048;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 4px;
    }

    /* ── OTP / Code block ── */
    .code-block {
      background: #1e1a16;
      border: 1px solid #3a3028;
      border-radius: 8px;
      text-align: center;
      padding: 28px;
      margin: 24px 0;
    }

    .code {
      font-family: 'Courier New', monospace;
      font-size: 36px;
      font-weight: 700;
      color: #c9a96e;
      letter-spacing: 8px;
    }

    .code-expires {
      font-size: 12px;
      color: #5a5048;
      margin-top: 8px;
    }

    /* ── Icon circle ── */
    .icon-circle {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-size: 28px;
    }

    .icon-circle-gold    { background: #2e2010; border: 1px solid #4d3820; }
    .icon-circle-success { background: #1a2e1a; border: 1px solid #2d4d2d; }
    .icon-circle-danger  { background: #2e1010; border: 1px solid #4d2020; }

    /* ── Section label ── */
    .section-label {
      font-size: 10px;
      color: #c9a96e;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    @media (max-width: 600px) {
      .card, .header, .footer { padding: 28px 24px; }
      .headline { font-size: 22px; }
      .info-row { flex-direction: column; align-items: flex-start; gap: 4px; }
      .info-value { text-align: left; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <!-- HEADER -->
    <div class="header">
      <img src="{{logoUrl}}" alt="{{appName}}" class="logo-img" />
      <div class="brand-name">{{appName}}</div>
      <div class="brand-tagline">Premium Saloon Booking</div>
    </div>

    <!-- CARD -->
    <div class="card">
      {{{body}}}
    </div>

    <!-- FOOTER -->
    <div class="footer">
      <p>
        © 2026 {{appName}}. All rights reserved.<br/>
        You received this email because you have an account with us.<br/>
        <a href="#">Unsubscribe</a> · <a href="#">Privacy Policy</a> · <a href="#">Help</a>
      </p>
    </div>
  </div>
</body>
</html>
