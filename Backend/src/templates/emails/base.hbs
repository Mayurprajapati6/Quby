<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <title>{{subject}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #0F172A;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #CBD5E1;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper {
      max-width: 600px;
      margin: 0 auto;
      padding: 32px 16px;
    }

    /* ── Header ── */
    .header {
      text-align: center;
      padding: 36px 40px 28px;
      background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
      border-top: 3px solid transparent;
      background-clip: padding-box;
      border-radius: 16px 16px 0 0;
      position: relative;
      overflow: hidden;
    }
    .header::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, #14B8A6, #6366F1, #8B5CF6, #06B6D4);
    }

    .logo-img {
      display: block;
      margin: 0 auto 12px;
      max-height: 48px;
      max-width: 160px;
      width: auto;
      object-fit: contain;
    }

    .logo-fallback {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #14B8A6, #6366F1);
      font-family: 'Outfit', sans-serif;
      font-size: 22px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 12px;
    }

    .brand-name {
      font-family: 'Outfit', sans-serif;
      font-size: 20px;
      font-weight: 700;
      color: #F1F5F9;
      letter-spacing: 0.5px;
    }

    .brand-tagline {
      font-size: 12px;
      color: #475569;
      letter-spacing: 0.5px;
      margin-top: 3px;
    }

    /* ── Body card ── */
    .card {
      background: #1E293B;
      border: 1px solid #334155;
      border-top: none;
      padding: 40px;
    }

    /* ── Footer ── */
    .footer {
      background: #0F172A;
      border: 1px solid #1E293B;
      border-top: none;
      border-radius: 0 0 16px 16px;
      padding: 24px 40px;
      text-align: center;
    }

    .footer p {
      font-size: 11px;
      color: #334155;
      line-height: 1.8;
    }

    .footer a {
      color: #475569;
      text-decoration: none;
    }
    .footer a:hover { color: #8B5CF6; }

    /* ── Typography ── */
    .greeting {
      font-size: 13px;
      color: #64748B;
      margin-bottom: 6px;
    }

    .headline {
      font-family: 'Outfit', sans-serif;
      font-size: 26px;
      font-weight: 700;
      color: #F1F5F9;
      line-height: 1.25;
      margin-bottom: 16px;
    }

    .body-text {
      font-size: 14px;
      color: #94A3B8;
      line-height: 1.75;
      margin-bottom: 16px;
    }

    /* ── Divider ── */
    .divider {
      border: none;
      border-top: 1px solid #1E293B;
      margin: 28px 0;
    }

    /* ── Info block ── */
    .info-block {
      background: #0F172A;
      border: 1px solid #334155;
      border-left: 3px solid #8B5CF6;
      border-radius: 0 12px 12px 0;
      padding: 4px 0;
      margin: 24px 0;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 12px 20px;
      border-bottom: 1px solid #1E293B;
      gap: 16px;
    }

    .info-row:last-child { border-bottom: none; }

    .info-label {
      font-size: 11px;
      color: #475569;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      font-weight: 500;
      white-space: nowrap;
      padding-top: 1px;
    }

    .info-value {
      font-size: 14px;
      color: #CBD5E1;
      font-weight: 500;
      text-align: right;
    }

    /* ── CTA button ── */
    .btn-wrap { text-align: center; margin: 32px 0; }

    .btn {
      display: inline-block;
      padding: 14px 36px;
      background: linear-gradient(135deg, #14B8A6, #6366F1, #8B5CF6);
      color: #ffffff !important;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.3px;
      text-decoration: none;
      border-radius: 10px;
    }

    .btn-secondary {
      display: inline-block;
      padding: 13px 36px;
      background: transparent;
      color: #8B5CF6 !important;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid #4C1D95;
      border-radius: 10px;
    }

    /* ── Status badge ── */
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .badge-success { background: rgba(16,185,129,0.15); color: #10B981; border: 1px solid rgba(16,185,129,0.25); }
    .badge-warning { background: rgba(245,158,11,0.15); color: #F59E0B; border: 1px solid rgba(245,158,11,0.25); }
    .badge-danger  { background: rgba(244,63,94,0.15);  color: #F43F5E; border: 1px solid rgba(244,63,94,0.25); }
    .badge-purple  { background: rgba(139,92,246,0.15); color: #8B5CF6; border: 1px solid rgba(139,92,246,0.25); }

    /* ── Amount highlight ── */
    .amount {
      font-family: 'Outfit', sans-serif;
      font-size: 36px;
      font-weight: 700;
      background: linear-gradient(135deg, #14B8A6, #8B5CF6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-align: center;
      padding: 16px 0;
    }

    .amount-label {
      font-size: 11px;
      color: #475569;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 4px;
    }

    /* ── OTP / Code block ── */
    .code-block {
      background: #0F172A;
      border: 1px solid #334155;
      border-radius: 12px;
      text-align: center;
      padding: 32px;
      margin: 24px 0;
    }

    .code {
      font-family: 'JetBrains Mono', 'Courier New', monospace;
      font-size: 38px;
      font-weight: 700;
      color: #8B5CF6;
      letter-spacing: 10px;
    }

    .code-expires {
      font-size: 12px;
      color: #475569;
      margin-top: 10px;
    }

    /* ── Icon circle ── */
    .icon-circle {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-size: 28px;
    }

    .icon-circle-primary { background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.3); }
    .icon-circle-success { background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.3); }
    .icon-circle-danger  { background: rgba(244,63,94,0.15);  border: 1px solid rgba(244,63,94,0.3); }
    .icon-circle-warning { background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.3); }
    .icon-circle-teal    { background: rgba(20,184,166,0.15); border: 1px solid rgba(20,184,166,0.3); }

    /* ── Section label ── */
    .section-label {
      font-size: 10px;
      color: #8B5CF6;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 10px;
    }

    /* ── Alert / warning box ── */
    .alert-box {
      background: rgba(245,158,11,0.08);
      border: 1px solid rgba(245,158,11,0.2);
      border-radius: 10px;
      padding: 14px 18px;
      margin-top: 20px;
      font-size: 13px;
      color: #94A3B8;
      line-height: 1.6;
    }

    .notice-box {
      background: rgba(139,92,246,0.08);
      border: 1px solid rgba(139,92,246,0.2);
      border-radius: 10px;
      padding: 14px 18px;
      margin-top: 20px;
      font-size: 13px;
      color: #94A3B8;
      line-height: 1.6;
    }

    @media (max-width: 600px) {
      .card, .header, .footer { padding: 24px 20px; }
      .headline { font-size: 22px; }
      .info-row { flex-direction: column; align-items: flex-start; gap: 4px; }
      .info-value { text-align: left; }
      .amount { font-size: 28px; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <!-- HEADER -->
    <div class="header">
      <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto 8px auto;">
        <tr>
          <td align="center" valign="middle" style="padding-right:10px;">
            <div style="width:40px;height:40px;border-radius:50%;border:4px solid #a78bfa;background:#1a0d2e;position:relative;display:inline-block;">
              <div style="position:absolute;width:3px;height:11px;background:#c084fc;border-radius:2px;bottom:50%;left:50%;transform-origin:bottom center;transform:translateX(-50%) rotate(-50deg);margin-left:-1px;"></div>
              <div style="position:absolute;width:2px;height:13px;background:#a78bfa;border-radius:2px;bottom:50%;left:50%;transform-origin:bottom center;transform:translateX(-50%) rotate(60deg);margin-left:-1px;"></div>
              <div style="position:absolute;width:5px;height:5px;background:#c084fc;border-radius:50%;top:50%;left:50%;transform:translate(-50%,-50%);"></div>
            </div>
          </td>
          <td align="left" valign="middle">
            <span style="font-family:Outfit,Arial,sans-serif;font-size:26px;font-weight:900;letter-spacing:-0.5px;line-height:1;">
              <span style="color:#c084fc;">Qu</span><span style="color:#f0f4ff;">by</span>
            </span>
          </td>
        </tr>
      </table>
      
      <div class="brand-tagline">Smart Salon Booking Platform</div>
    </div>

    <!-- CARD -->
    <div class="card">
      {{{body}}}
    </div>

    <!-- FOOTER -->
    <div class="footer">
      <p>
        © 2026 {{appName}}. All rights reserved.<br/>
        You received this email because you have an account with us.<br/>
        <a href="#">Unsubscribe</a> · <a href="#">Privacy Policy</a> · <a href="#">Help</a>
      </p>
    </div>
  </div>
</body>
</html>
