<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Booking Cancelled By Business</title>
  <style>    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap');
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:#0F172A;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#CBD5E1;-webkit-font-smoothing:antialiased}
    .wrapper{max-width:600px;margin:0 auto;padding:32px 16px}
    .header{text-align:center;padding:28px 40px 22px;background:linear-gradient(135deg,#1E293B 0%,#0F172A 100%);border-radius:16px 16px 0 0;position:relative;overflow:hidden}
    /* header border handled inline */
    .card{background:#1E293B;border:1px solid #334155;border-top:none;padding:40px}
    .footer{background:#0F172A;border:1px solid #1E293B;border-top:none;border-radius:0 0 16px 16px;padding:20px 40px;text-align:center}
    .footer p{font-size:11px;color:#334155;line-height:1.8}
    .footer a{color:#475569;text-decoration:none}
    .icon-circle{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:28px}
    .ic-purple{background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.3)}
    .ic-success{background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3)}
    .ic-danger{background:rgba(244,63,94,0.15);border:1px solid rgba(244,63,94,0.3)}
    .ic-warning{background:rgba(245,158,11,0.15);border:1px solid rgba(245,158,11,0.3)}
    .section-label{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;font-weight:600;margin-bottom:12px}
    .sl-purple{color:#8B5CF6} .sl-success{color:#10B981} .sl-danger{color:#F43F5E} .sl-warning{color:#F59E0B}
    .headline{font-family:'Outfit',sans-serif;font-size:26px;font-weight:700;color:#F1F5F9;line-height:1.3;margin-bottom:8px;text-align:center}
    .sub{font-size:14px;color:#64748B;text-align:center;margin-bottom:24px;line-height:1.6}
    .info-block{background:#0F172A;border:1px solid #334155;border-radius:0 12px 12px 0;overflow:hidden;margin:20px 0}
    .ib-purple{border-left:3px solid #8B5CF6} .ib-success{border-left:3px solid #10B981} .ib-danger{border-left:3px solid #F43F5E} .ib-warning{border-left:3px solid #F59E0B}
    .info-row{display:table;width:100%;border-bottom:1px solid #1E293B;table-layout:fixed}
    .info-row:last-child{border-bottom:none}
    .info-label{display:table-cell;width:120px;font-size:11px;color:#475569;letter-spacing:0.8px;text-transform:uppercase;font-weight:500;padding:12px 0 12px 18px;white-space:nowrap;width:110px;vertical-align:middle}
    .info-value{display:table-cell;max-width:0;font-size:13px;color:#CBD5E1;font-weight:500;padding:12px 18px 12px 12px;text-align:right;vertical-align:middle;word-break:break-word}
    .amount-wrap{border-radius:12px;padding:20px 24px;text-align:center;margin:20px 0}
    .aw-purple{background:linear-gradient(135deg,#7C3AED,#8B5CF6)}
    .aw-green{background:linear-gradient(135deg,#10B981,#14B8A6)}
    .amount-lbl{font-size:10px;color:rgba(255,255,255,0.65);letter-spacing:1.2px;text-transform:uppercase;margin-bottom:6px}
    .amount{font-family:'Outfit',sans-serif;font-size:38px;font-weight:800;color:#fff;line-height:1}
    .body-text{font-size:14px;color:#94A3B8;line-height:1.75;text-align:center;margin-bottom:16px}
    .divider{border:none;border-top:1px solid #1E293B;margin:24px 0}
    .notice-box{background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.2);border-radius:10px;padding:14px 18px;font-size:13px;color:#94A3B8;line-height:1.6;margin-top:16px}
    .alert-box{background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);border-radius:10px;padding:14px 18px;font-size:13px;color:#94A3B8;line-height:1.6;margin-top:16px}
    .danger-box{background:rgba(244,63,94,0.07);border:1px solid rgba(244,63,94,0.2);border-radius:10px;padding:14px 18px;font-size:13px;color:#94A3B8;line-height:1.6;margin-top:16px}
    .success-box{background:rgba(16,185,129,0.07);border:1px solid rgba(16,185,129,0.2);border-radius:10px;padding:14px 18px;font-size:13px;color:#94A3B8;line-height:1.6;margin-top:16px}
    .btn-wrap{text-align:center;margin:28px 0}
    .btn{display:inline-block;padding:13px 32px;background:linear-gradient(135deg,#7C3AED,#6366F1);color:#fff!important;font-family:'Inter',sans-serif;font-size:14px;font-weight:600;text-decoration:none;border-radius:10px}
    .btn-danger{background:linear-gradient(135deg,#F43F5E,#8B5CF6)}
    .code-block{background:#0F172A;border:1px solid #334155;border-radius:12px;text-align:center;padding:28px;margin:24px 0}
    .code{font-family:'Courier New',monospace;font-size:12px;color:#8B5CF6;word-break:break-all}
    .code-expires{font-size:12px;color:#475569;margin-top:8px}
    @media(max-width:600px){.card,.header,.footer{padding:24px 20px}.headline{font-size:22px}.amount{font-size:28px}}</style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto 8px auto;">
      <tr>
        <td align="center" valign="middle" style="padding-right:10px;">
          <!--[if !mso]><!-->
          <!-- Mirror mark: circle + clock hands using CSS -->
          <div style="width:40px;height:40px;border-radius:50%;border:4px solid #a78bfa;background:#1a0d2e;position:relative;display:inline-block;">
            <!-- Hour hand ~10 o'clock: rotated div -->
            <div style="position:absolute;width:3px;height:11px;background:#c084fc;border-radius:2px;bottom:50%;left:50%;transform-origin:bottom center;transform:translateX(-50%) rotate(-50deg);margin-left:-1px;"></div>
            <!-- Minute hand ~2 o'clock -->
            <div style="position:absolute;width:2px;height:13px;background:#a78bfa;border-radius:2px;bottom:50%;left:50%;transform-origin:bottom center;transform:translateX(-50%) rotate(60deg);margin-left:-1px;"></div>
            <!-- Center pivot dot -->
            <div style="position:absolute;width:5px;height:5px;background:#c084fc;border-radius:50%;top:50%;left:50%;transform:translate(-50%,-50%);"></div>
          </div>
          <!--<![endif]-->
        </td>
        <td align="left" valign="middle">
          <span style="font-family:Outfit,Arial,sans-serif;font-size:26px;font-weight:900;letter-spacing:-0.5px;line-height:1;mso-line-height-rule:exactly;">
            <span style="color:#c084fc;">Qu</span><span style="color:#f0f4ff;">by</span>
          </span>
        </td>
      </tr>
    </table>
  </div>
  <div class="card">
    <div class="icon-circle ic-danger">✕</div>
    <div class="section-label sl-danger" style="text-align:center">Booking Cancelled</div>
    <h1 class="headline">Your booking was<br/>cancelled by the salon.</h1>
    <p class="sub">Hi <strong style="color:#E2E8F0">{{customerName}}</strong>, we're sorry — <strong style="color:#E2E8F0">{{businessName}}</strong> had to cancel your appointment.</p>
    <div class="info-block ib-danger">
      <div class="info-row"><span class="info-label">Booking #</span><span class="info-value" style="color:#FDA4AF">#{{bookingNumber}}</span></div>
      <div class="info-row"><span class="info-label">Date</span><span class="info-value">{{formatDate serviceDate}}</span></div>
      <div class="info-row"><span class="info-label">Salon</span><span class="info-value">{{businessName}}</span></div>
      {{#if reason}}<div class="info-row"><span class="info-label">Reason</span><span class="info-value">{{reason}}</span></div>{{/if}}
    </div>
    {{#if refundAmount}}<div class="amount-wrap aw-green">
      <div class="amount-lbl">Refund Amount</div>
      <div class="amount">{{formatCurrency refundAmount}}</div>
    </div>
    <p class="body-text" style="font-size:12px;margin-top:6px">Your refund will be processed within 5–7 business days.</p>{{/if}}
    <div class="danger-box">We apologise for the inconvenience. Use the Quby app to book a new appointment.</div>
  </div>
  <div class="footer">
    <p>© 2026 Quby. All rights reserved.<br/>
    <a href="#">Unsubscribe</a> · <a href="#">Privacy Policy</a> · <a href="#">Help</a></p>
  </div>
</div>
</body>
</html>